dist/
releases/
archive/

# ===== 依赖 =====
node_modules/
tools/node_modules/
__pycache__/
*.pyc

# ===== 一次性脚本 / 验证日志（临时产物）=====
tools/dev/
tools/verification/
scripts/tests/artifacts/

